# LLM backend. Ollama locally, vLLM on Kaggle - both speak the OpenAI protocol.
AQ_BASE_URL=http://localhost:11434/v1
AQ_API_KEY=ollama
AQ_BACKEND=ollama

# Model per agent role. Small models are fine for classification and review;
# SQL generation gets the best model the current tier can afford.
AQ_MODEL_LEAD=qwen2.5-coder:3b
AQ_MODEL_SQL=qwen2.5-coder:3b
AQ_MODEL_CRITIC=qwen2.5-coder:3b
AQ_MODEL_ANALYST=qwen2.5-coder:3b

# Database
AQ_DB_URL=sqlite:///data/db/demo.db

# Safety rails
AQ_MAX_ROWS=500
AQ_QUERY_TIMEOUT_S=30
